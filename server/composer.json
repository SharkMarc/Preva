{
  "name": "spoehner/preva",
  "description": "process evaluation",
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "7.4"
    }
  },
  "autoload": {
    "psr-4": {
      "Preva\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Preva\\Test\\": "tests"
    }
  },
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-xmlreader": "*",
    "mpdf/mpdf": "^6.1",
    "phpmailer/phpmailer": "^6.6",
    "symfony/dotenv": "^5.4",
    "symfony/mailer": "^5.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "roave/security-advisories": "dev-latest"
  }
}
